{
  "name": "mi-finanzas-android",
  "version": "1.0.0",
  "private": true,
  "description": "Empaquetado Android de Mi Finanzas",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "android:add": "cap add android",
    "android:sync": "npm run build:web && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
